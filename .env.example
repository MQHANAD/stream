# ------------------------------------------------------------------
# CAM_STREAM_URL is now OPTIONAL. If MediaMTX runs on the same machine
# as this app (the common case - Tailscale, LAN, or plain local dev),
# leave it unset: the WHEP URL is derived automatically per-request from
# the host the browser used to reach this app (localhost / LAN IP /
# Tailscale IP all work without any config changes). See
# docs/ENVIRONMENT_VARIABLES.md and docs/TAILSCALE.md for how this works.
#
# Only set this explicitly when MediaMTX is NOT reachable at the same
# host as this app - e.g. this app is deployed to Vercel and MediaMTX is
# exposed separately via Cloudflare Tunnel:
#
#   CAM_STREAM_URL=https://cam.example.com/cam/whep
#
# Never set it to "localhost" or "127.0.0.1" - the app detects and
# overrides that automatically (with a warning) since those are only
# reachable from the machine running the app itself, not from a phone.
# ------------------------------------------------------------------
CAM_STREAM_URL=

# ------------------------------------------------------------------
# Only used when CAM_STREAM_URL is unset (auto-derived mode). Defaults
# shown - uncomment to override.
# ------------------------------------------------------------------
# CAM_MEDIAMTX_PROTOCOL=http
# CAM_MEDIAMTX_PORT=8889
# CAM_STREAM_PATH=/cam/whep
# CAM_MEDIAMTX_API_PORT=9997

# ------------------------------------------------------------------
# HTTP Basic Auth credentials.
# These protect every route in this app (see middleware.ts) and are
# also forwarded as a Basic Auth header when the server calls
# MediaMTX, so they double as MediaMTX credentials if you turn on
# authInternalUsers for the path (see docs/MEDIAMTX_CONFIG.md).
# ------------------------------------------------------------------
CAM_USERNAME=
CAM_PASSWORD=
